APP_NAME="Photo Studio SaaS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=photo_studio_saas
DB_USERNAME=photo_studio
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=photostudio_cache

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Generated by `php artisan jwt:secret`
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Set MAIL_MAILER=resend and provide a real key to actually send mail (see https://resend.com).
RESEND_API_KEY=

# One bot for platform/admin notifications, created via @BotFather — separate
# from the bot each tenant connects for their own customers.
PLATFORM_TELEGRAM_BOT_TOKEN=
PLATFORM_TELEGRAM_BOT_USERNAME=
PLATFORM_TELEGRAM_WEBHOOK_SECRET=

# S3-compatible storage (AWS S3, DigitalOcean Spaces, MinIO, ...).
# Set FILESYSTEM_DISK=s3 to activate once these are filled in.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Bootstrapped by database/seeders/SuperAdminSeeder
SUPER_ADMIN_EMAIL=admin@platform.test
SUPER_ADMIN_PASSWORD=password

# Headless Chrome used for invoice PDF rendering (see config/browsershot.php).
# Defaults match the Docker image's apk-installed chromium/node — only
# needed here if running the backend directly on the host.
# BROWSERSHOT_CHROME_PATH=/usr/bin/chromium-browser
# BROWSERSHOT_NODE_BINARY=/usr/bin/node
# BROWSERSHOT_NODE_MODULES_PATH=/var/www/html/node_modules
