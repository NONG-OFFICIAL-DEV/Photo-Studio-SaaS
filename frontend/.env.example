VITE_APP_NAME="Photo Studio SaaS"
# In local dev the Vite server proxies /api to VITE_API_BASE_URL's target
# (see vite.config.js). In production, point this at the real API origin,
# e.g. https://api.yourstudio.com/api
VITE_API_BASE_URL=/api

# "Sign in with Google" — the OAuth client ID from Google Cloud Console
# (Credentials > OAuth client ID > Web application). Must match the
# backend's GOOGLE_CLIENT_ID exactly (used as the token's audience check).
VITE_GOOGLE_CLIENT_ID=

# Must match the backend's REVERB_APP_KEY/HOST/PORT/SCHEME (backend/.env) —
# this is a separate Vite app, it never reads the backend's .env. In
# production, point these at wherever Reverb is actually reachable (behind
# a reverse proxy with wss, typically a different port/subdomain than the
# API itself).
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
